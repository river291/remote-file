{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建",
      "type": "shell",
      "command": "node esbuild.mjs",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "类型检查",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "构建并跑测试",
      "type": "shell",
      "command": "npm test",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
